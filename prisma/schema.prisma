// ============================================================ PLATFORM

model PlatformSetting {
  id                   String           @id @default("singleton")
  pricePerUserPaise    Int              @default(5900)
  currency             String           @default("INR")
  /// Billing period the price applies to. MONTHLY per the product decision.
  /// @unreachable-ok billing is monthly everywhere; nothing offers another period
  billingPeriod        String           @default("MONTHLY")
  /// Leads the platform's own invoice numbers: BMG-2026-0015.
  ///
  /// The organisation prefix answers "whose employee is this"; this one
  /// answers "who issued this invoice", and the issuer is always the platform.
  invoicePrefix        String           @default("BMG") @db.VarChar(4)
  paymentUpiId         String           @default("8434232412@ptyes")
  paymentPayeeName     String           @default("HRMS Platform")
  /// Platform-wide logo. Falls back to the built-in mark when unset, and is
  /// what the PWA icons are generated from.
  logoKey              String?
  paymentWindowMinutes Int              @default(240)
  /// UTR = org submits a reference; CODE = superadmin issues a code; BOTH = either.
  confirmationMode     ConfirmationMode @default(BOTH)
  otpTtlMinutes        Int              @default(15)
  defaultTrialDays     Int              @default(14)
  /// Whether anyone may create an organisation without a Superadmin.
  selfSignupEnabled    Boolean          @default(true)
  /// Seats a self-signed-up organisation starts with.
  signupSeats          Int              @default(5)
  /// Days a seat-limit breach is tolerated before activation is blocked. 0 = block immediately.
  seatGraceDays        Int              @default(0)
  /// Attendance selfies are purged after this many days; the record is kept.
  selfieRetentionDays  Int              @default(60)
  /// @unreachable-ok web push was never built -- no subscription is ever written either
  pushVapidPublicKey   String?
  defaultAiModel       String           @default("z-ai/glm-5.3-flash")
  maintenanceMode      Boolean          @default(false)
  /// When the nightly maintenance run last finished. Read by `/api/health?deep=1`
  /// so an uptime check can see a night that did not happen: a live container
  /// and a cron that stopped firing look identical from outside.
  lastMaintenanceAt    DateTime?
  /// @unreachable-ok superseded by FeatureGrant and OrgModuleSetting, which are the two levels the product actually has
  featureFlags         Json             @default("{}")
  updatedAt            DateTime         @updatedAt
  updatedById          String?
}

/// A slug an organisation used to live at.
///
/// `/o/<slug>` is printed on emails, bookmarked, and baked into the start URL of
/// every installed PWA, so renaming one would otherwise quietly strand all
/// three: the old address still loads, but it resolves to nobody and serves the
/// product's own name and icon instead of the company's.
///
/// Kept as rows rather than an array on the organisation so the unique index is
/// real: a slug any company has *ever* used cannot be taken by another, or one
/// address would point at two.
model OrganizationSlug {
  id             String   @id @default(cuid())
  organizationId String
  slug           String   @unique
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Organization {
  id                       String    @id @default(cuid())
  name                     String
  legalName                String?
  slug                     String    @unique
  logoKey                  String?
  /// The company seal, printed beside the signature on a letter. One per
  /// company, unlike `LetterTemplate.signatureKey`, which is per letter type
  /// because different letters are signed by different people.
  stampKey                 String?
  /// The authorised signatory, for every letter this organisation issues.
  ///
  /// The signature used to live only on `LetterTemplate`, one row per letter
  /// category, uploaded inside the template editor one category at a time. So
  /// uploading it for the offer letter left the other nine unsigned, and there
  /// was nowhere in organisation settings to put it at all -- which is why it
  /// "did not appear in letters". The stamp was already here; the signature
  /// belongs beside it.
  ///
  /// A template may still override all three, for the rare letter somebody else
  /// signs. Absent there means "use the organisation's".
  signatureKey             String?
  signatoryName            String?
  signatoryTitle           String?
  email                    String?
  phone                    String?
  website                  String?
  industry                 String?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  country                  String    @default("India")
  postalCode               String?
  /// Statutory identifiers an offer or appointment letter has to quote. They
  /// belong to the organisation, and letters read them through the placeholder
  /// catalogue like any other organisation field.
  cin                      String?
  gstin                    String?
  panNumber                String?
  tan                      String?
  pfCode                   String?
  esiCode                  String?
  timezone                 String    @default("Asia/Kolkata")
  currency                 String    @default("INR")
  locale                   String    @default("en-IN")
  status                   OrgStatus @default(PENDING_PAYMENT)
  seatLimit                Int       @default(0)
  /// @unreachable-ok superseded by OrgModuleSetting; module state is two-level and lives there
  enabledFeatures          Json      @default("[]")
  /// @unreachable-ok payroll and leave both run on the calendar year; nothing reads this
  fiscalYearStartMonth     Int       @default(4)
  /// How many days a new hire stays on probation, unless the person adding them
  /// says otherwise. Ninety is the common default in Indian employment; it is a
  /// starting point for the form, not a rule the product enforces.
  /// The last year the default-on holidays were filled in for.
  ///
  /// The three national days arrive on and arrive again every year, and an
  /// organisation can switch one off. Those two only coexist because of this
  /// column: the maintenance job seeds forward from it and records that it did,
  /// so it never revisits a year -- and a holiday somebody deleted stays
  /// deleted rather than reappearing on the next run.
  holidaysSeededThrough    Int?
  probationDays            Int       @default(90)
  /// How long a new hire stays in training, when they start there rather than
  /// on probation. Thirty days is a common default; like `probationDays` it
  /// fills in a date on the form and enforces nothing.
  trainingDays             Int       @default(30)
  /// The three letters every employee code in this organisation starts with,
  /// chosen when it is created. It used to be inferred from whichever existing
  /// code had the highest numeric tail, which picked the wrong one the moment a
  /// directory held two patterns -- and gave a brand-new organisation "EMP".
  /// Three or four letters. Leads every number this organisation issues: its
  /// employee codes, its letters, its expense claims and its payslips.
  employeeCodePrefix       String    @default("EMP") @db.VarChar(4)
  /// Whether letters and payslips print the statutory identifiers below the
  /// address. Off by default: most of them are blank for most organisations,
  /// and a letterhead listing empty labels looks worse than one without them.
  /// Kept as the fallback for organisations that have not opened the new
  /// screen: on used to mean all six identifiers on every document, and that is
  /// what they keep until they choose otherwise.
  showStatutoryOnDocuments Boolean   @default(false)
  /// Which statutory identifiers print on which document. `{ payslip, letter,
  /// fnf }`, each a list of identifier keys. Null means "never chosen", and
  /// `resolveDocumentIdentifiers` falls back to the boolean above.
  documentIdentifiers      Json?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  createdById              String?
  suspendedAt              DateTime?
  suspendedReason          String?

  users                 User[]
  employees             Employee[]
  departments           Department[]
  designations          Designation[]
  designationReportings DesignationReporting[]
  chatThreads           ChatThread[]
  chatMessages          ChatMessage[]
  chatBlocks            ChatBlock[]
  chatReports           ChatReport[]
  workLocations         WorkLocation[]
  shifts                Shift[]
  holidays              Holiday[]
  leaveTypes            LeaveType[]
  carryForwardRuns      LeaveCarryForwardRun[]
  goalProgress          GoalProgress[]
  leaveRequests         LeaveRequest[]
  leaveBalances         LeaveBalance[]
  attendanceDays        AttendanceDay[]
  attendanceEvents      AttendanceEvent[]
  salaryComponents      SalaryComponent[]
  salaryProfiles        SalaryProfile[]
  payrollRuns           PayrollRun[]
  salaryAdvances        SalaryAdvance[]
  documents             EmployeeDocument[]
  announcements         Announcement[]
  letterTemplates       LetterTemplate[]
  letters               Letter[]
  aiConfig              AiConfig?
  subscription          Subscription?
  paymentOrders         PaymentOrder[]
  policyVersions        OrgPolicyVersion[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  weeklyOffPatterns     WeeklyOffPattern[]
  subscriptionHistory   SubscriptionHistory[]
  coupons               Coupon[]
  paymentCodes          PaymentCode[]
  pastSlugs             OrganizationSlug[]
  featureGrants         FeatureGrant[]
  moduleSettings        OrgModuleSetting[]
  seatSnapshots         SeatUsageSnapshot[]
  exitRecords           ExitRecord[]
  fnfSettlements        FnfSettlement[]
  reimbursementClaims   ReimbursementClaim[]
  recognitionParameters RecognitionParameter[]
  recognitionCycles     RecognitionCycle[]
  recognitionAwards     RecognitionAward[]
  onboardingTemplates   OnboardingTemplate[]
  onboardingTasks       OnboardingTask[]
  assets                Asset[]
  assetAssignments      AssetAssignment[]
  reviewCycles          ReviewCycle[]
  goals                 Goal[]
  performanceReviews    PerformanceReview[]
  regularisations       AttendanceRegularisation[]
  dataExports           DataExportJob[]
  loginEvents           LoginEvent[]
  kioskDevices          KioskDevice[]
  attendancePins        AttendancePin[]
  pinAuthorities        AttendancePinAuthority[]
  designationModules    DesignationModuleSetting[]
  designationLeave      DesignationLeaveAllocation[]
  userModules           UserModuleSetting[]

  @@index([status])
  @@index([createdAt])
}

model User {
  id                 String     @id @default(cuid())
  organizationId     String?
  email              String
  passwordHash       String
  name               String
  phone              String?
  /// @unreachable-ok no avatar upload exists; the shell draws initials
  avatarKey          String?
  role               SystemRole
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?
  /// When this person accepted the Terms and Privacy Policy, and which version
  /// they accepted. An acceptance that is not recorded is not an acceptance —
  /// "they must have ticked it" is not something anybody can produce later.
  termsAcceptedAt    DateTime?
  termsVersion       String?
  totpSecretCipher   String?
  totpEnabledAt      DateTime?
  /// SHA-256 of each unused recovery code. Plaintext is shown once, at enrolment.
  totpRecoveryHashes String[]   @default([])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  organization         Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee             Employee?
  sessions             Session[]
  permissionGrants     UserPermissionGrant[]
  moduleSettings       UserModuleSetting[]    @relation("ModuleSetting")
  passwordResets       PasswordResetRequest[]
  notifications        Notification[]
  auditLogs            AuditLog[]             @relation("AuditActor")
  announcements        Announcement[]         @relation("AnnouncementAuthor")
  announcementLikes    AnnouncementLike[]
  announcementComments AnnouncementComment[]
  pushSubscriptions    PushSubscription[]
  loginEvents          LoginEvent[]
  kioskDevice          KioskDevice?

  @@unique([organizationId, email])
  @@index([email])
  @@index([organizationId, role])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  ipAddress   String?
  userAgent   String?
  /// Friendly label derived from the user agent, e.g. "Chrome on Windows".
  deviceLabel String?
  lastSeenAt  DateTime?
  revokedById String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserPermissionGrant {
  id         String   @id @default(cuid())
  userId     String
  permission String
  granted    Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

model PasswordResetRequest {
  id             String              @id @default(cuid())
  userId         String
  organizationId String?
  requestedEmail String
  otpHash        String
  otpCipher      String?
  status         PasswordResetStatus @default(PENDING)
  attemptCount   Int                 @default(0)
  expiresAt      DateTime
  releasedAt     DateTime?
  releasedById   String?
  consumedAt     DateTime?
  rejectedReason String?
  ipAddress      String?
  createdAt      DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

// ============================================================ BILLING

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String             @unique
  seats              Int                @default(0)
  status             SubscriptionStatus @default(TRIAL)
  /// Superadmin picks this per organisation: trial, paying, or free/internal.
  billingMode        BillingMode        @default(TRIAL)
  /// Renewal period for a paying organisation. Annual is the default because it
  /// is what every subscription created before this field existed actually got.
  billingCycle       BillingCycle       @default(ANNUAL)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  nextBillingDate    DateTime?
  /// Seat overage tolerated until this instant; null = no grace.
  graceUntil         DateTime?
  pricePerUserPaise  Int
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
  @@index([billingMode, trialEndsAt])
}

model SubscriptionHistory {
  id                String    @id @default(cuid())
  organizationId    String
  paymentOrderId    String?
  previousSeats     Int
  newSeats          Int
  previousPeriodEnd DateTime?
  newPeriodEnd      DateTime
  amountPaise       Int
  note              String?
  createdAt         DateTime  @default(now())
  createdById       String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentOrder PaymentOrder? @relation(fields: [paymentOrderId], references: [id])

  @@index([organizationId, createdAt])
}

model Coupon {
  id               String   @id @default(cuid())
  code             String   @unique
  description      String?
  percent          Decimal  @db.Decimal(5, 2)
  maxDiscountPaise Int?
  startsAt         DateTime
  expiresAt        DateTime
  maxRedemptions   Int?
  redemptionCount  Int      @default(0)
  /// How many times one organisation may use this coupon. Null = as often as
  /// they like. `maxRedemptions` is the total across everybody; this is the
  /// per-buyer limit, and without it a single organisation could spend a
  /// hundred-use launch coupon on its own renewals.
  maxPerOrganisation Int?
  minUserCount     Int?
  maxUserCount     Int?
  /// Only for an organisation that has never had an order approved. The offer
  /// that brings somebody in should not keep paying out on their renewals.
  firstPurchaseOnly Boolean @default(false)
  /// Whether it appears in the list at checkout.
  ///
  /// Off by default, and deliberately: a coupon is private until somebody
  /// decides to publish it. A code emailed to one customer must not turn up in
  /// a dropdown for everybody else, and the safe direction for a default that
  /// reveals a discount is closed.
  listed           Boolean  @default(false)
  appliesToOrgId   String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  createdById      String?

  organization Organization?      @relation(fields: [appliesToOrgId], references: [id], onDelete: SetNull)
  redemptions  CouponRedemption[]
  orders       PaymentOrder[]

  @@index([active, startsAt, expiresAt])
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  paymentOrderId String   @unique
  organizationId String
  discountPaise  Int
  createdAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, paymentOrderId])
  @@index([organizationId])
}

model PaymentOrder {
  id                String             @id @default(cuid())
  organizationId    String
  orderNumber       String             @unique
  userCount         Int
  pricePerUserPaise Int
  subtotalPaise     Int
  discountPaise     Int                @default(0)
  payablePaise      Int
  couponId          String?
  couponCode        String?
  status            PaymentOrderStatus @default(INITIATED)
  upiId             String
  periodMonths      Int                @default(12)
  /// Mode UTR: the reference the organisation typed in.
  confirmationCode  String?
  transactionRef    String?
  payerNote         String?
  /// Mode CODE: superadmin-issued code. Hash is compared; cipher lets the
  /// superadmin re-read the code they issued. Both cleared once consumed.
  issuedCodeHash    String?
  issuedCodeCipher  String?
  codeIssuedAt      DateTime?
  codeIssuedById    String?
  codeAttemptCount  Int                @default(0)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  reviewNote        String?
  infoRequestNote   String?
  expiresAt         DateTime
  windowMinutes     Int
  previousSeats     Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdById       String?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  coupon       Coupon?               @relation(fields: [couponId], references: [id])
  history      SubscriptionHistory[]
  events       PaymentOrderEvent[]
  /// The advance code applied at checkout or spent at confirmation, if any.
  paymentCode  PaymentCode?

  @@index([status, createdAt])
  @@index([organizationId, createdAt])
  @@index([expiresAt])
}

/// A code the platform owner hands out before there is an order.
///
/// The order-bound confirmation code (`PaymentOrder.issuedCode*`) is issued
/// against a request already in the queue. This is the other direction: made
/// on the phone for an organisation that has not yet pressed Buy, optionally
/// with a discount, optionally tied to one organisation, spent once. Six
/// digits, like the order-bound code, so the same box accepts both.
model PaymentCode {
  id               String    @id @default(cuid())
  /// SHA-256, so the code can be found by value at checkout and at
  /// confirmation -- bcrypt cannot be looked up. Guessing is rate-limited and
  /// every code that was not issued against the order itself still goes
  /// through approval, so the hash is a lookup key rather than a secret.
  codeHash         String
  /// The code itself, encrypted, so the owner can re-read what they handed out.
  codeCipher       String
  /// Null means any organisation may use it.
  organizationId   String?
  /// Off what is owed at the moment it is applied. Null means the code confirms
  /// payment and changes nothing.
  discountPercent  Decimal?  @db.Decimal(5, 2)
  maxDiscountPaise Int?
  expiresAt        DateTime
  /// Who it was given to and why, in the issuer's words.
  note             String?
  issuedById       String
  issuedAt         DateTime  @default(now())
  /// The order it was applied to at checkout or spent on at confirmation.
  paymentOrderId   String?   @unique
  appliedAt        DateTime?
  usedAt           DateTime?
  revokedAt        DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@index([codeHash])
  @@index([organizationId, issuedAt])
  @@index([issuedAt])
}

model PaymentOrderEvent {
  id             String              @id @default(cuid())
  paymentOrderId String
  fromStatus     PaymentOrderStatus?
  toStatus       PaymentOrderStatus
  note           String?
  actorId        String?
  createdAt      DateTime            @default(now())

  order PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)

  @@index([paymentOrderId, createdAt])
}

// ============================================================ ORG STRUCTURE

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  description    String?
  /// @unreachable-ok reporting lines are per designation, not per department head
  headEmployeeId String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Designation {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  level          Int      @default(0)
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  /// Week offs a month this role is owed, overriding the payroll rule.
  ///
  /// Null means "whatever the organisation's payroll rules say", which is
  /// itself allowed to mean "whatever the weekly-off pattern gives". Three
  /// layers, resolved the same way leave allocation already is: the person's
  /// designation, then the policy, then the pattern.
  weekOffsPerMonth Int?

  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees        Employee[]
  reportsTo        DesignationReporting[]       @relation("FromDesignation")
  reportedBy       DesignationReporting[]       @relation("ToDesignation")
  pinAuthority     AttendancePinAuthority[]
  moduleSettings   DesignationModuleSetting[]
  leaveAllocations DesignationLeaveAllocation[]

  @@unique([organizationId, title])
  @@index([organizationId])
}

/// One year-end carry-forward, and enough of the balances it changed to undo it.
///
/// `runCarryForward` writes with `set` rather than `increment`, which makes a
/// re-run harmless and an undo impossible: once the new figure is in, the old
/// one is gone. Every line's prior value is kept here so a run can be taken
/// back — and put back again, because somebody who undoes the wrong one should
/// not have to reconstruct it by hand.
///
/// `lines` is a JSON array of { employeeId, leaveTypeId, before, after }, where
/// `before` is null for a balance row the run created. Kept as JSON rather than
/// a table because it is read as a whole, written once, and never queried
/// across runs.
model LeaveCarryForwardRun {
  id             String   @id @default(cuid())
  organizationId String
  fromYear       Int
  toYear         Int
  /// Days actually carried, for the list. The detail is in `lines`.
  days           Decimal  @default(0) @db.Decimal(8, 2)
  employees      Int      @default(0)
  lines          Json
  ranById        String?
  ranAt          DateTime @default(now())
  /// Set when the run has been taken back. A redo clears it again.
  undoneAt       DateTime?
  undoneById     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, ranAt])
}

model DesignationReporting {
  id                     String        @id @default(cuid())
  organizationId         String
  designationId          String
  reportsToDesignationId String
  type                   ReportingType @default(PRIMARY)
  createdAt              DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  designation  Designation  @relation("FromDesignation", fields: [designationId], references: [id], onDelete: Cascade)
  reportsTo    Designation  @relation("ToDesignation", fields: [reportsToDesignationId], references: [id], onDelete: Cascade)

  @@unique([designationId, reportsToDesignationId, type])
  @@index([organizationId, designationId])
}

model WorkLocation {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// Street and building. Shown as the first line of a branch's address.
  address        String?
  /// Area, city, pin — whatever does not belong on the first line.
  ///
  /// A branch address used to be one free-text box, and the reception screen
  /// never received it at all: the kiosk context selected the location's name
  /// and its coordinates and nothing else, so a device standing in a building
  /// could not say which building it was standing in.
  addressLine2   String?
  latitude       Decimal  @db.Decimal(10, 7)
  longitude      Decimal  @db.Decimal(10, 7)
  radiusMeters   Int      @default(150)
  requireSelfie  Boolean  @default(true)
  requireGps     Boolean  @default(true)
  active         Boolean  @default(true)
  /// The branch a new employee joins when nobody chooses one for them.
  ///
  /// Every employee in production had `workLocationId = NULL`, because the
  /// employee form lets the field be skipped and nothing filled it in. With no
  /// work location the geofence is never evaluated at all -- `requireGps` only
  /// forces coordinates to be *present* -- so attendance was markable from
  /// anywhere. A default branch is what stops that happening again on the next
  /// employee somebody adds in a hurry.
  ///
  /// At most one per organisation; `setPrimaryWorkLocation` clears the others in
  /// the same transaction. Where none is marked, the oldest active location is
  /// used, so an organisation that never thinks about this still gets a fence.
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]
  kioskDevices KioskDevice[]

  @@unique([organizationId, name])
  @@index([organizationId, isPrimary])
}

model Shift {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  startTime       String
  endTime         String
  breakMinutes    Int      @default(60)
  graceMinutes    Int      @default(10)
  isDefault       Boolean  @default(false)
  crossesMidnight Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
}

model WeeklyOffPattern {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  type           WeeklyOffType @default(FIXED)
  // FIXED:      { "days": [0] }                                   (0 = Sunday)
  // MULTIPLE:   { "days": [0, 6] }
  // ROTATIONAL: { "days": [0], "rotating": [{ "day": 6, "weeks": [2, 4] }] }
  // CUSTOM:     { "dates": ["2026-01-04"] }
  config         Json
  isDefault      Boolean       @default(false)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
}

model Holiday {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  date           DateTime    @db.Date
  type           HolidayType @default(PUBLIC)
  paid           Boolean     @default(true)
  optional       Boolean     @default(false)
  regions        String[]    @default([])
  departmentIds  String[]    @default([])
  employeeIds    String[]    @default([])
  note           String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name, date])
  @@index([organizationId, date])
}

// ============================================================ EMPLOYEES

model Employee {
  id             String  @id @default(cuid())
  organizationId String
  userId         String? @unique
  employeeCode   String

  firstName         String
  lastName          String?
  photoKey          String?
  gender            Gender?
  dateOfBirth       DateTime? @db.Date
  personalEmail     String?
  workEmail         String?
  phone             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  country           String?
  postalCode        String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  /// Health data under the SPDI Rules, and it sat in plaintext beside encrypted
  /// bank details for as long as the column existed. Encrypted like the rest;
  /// the emergency contact who needs it is the only reason it is collected.
  bloodGroupCipher  String?
  /// The plaintext it replaced. Kept only until `npm run migrate:bloodgroup` has
  /// run everywhere; the app writes the cipher and reads it first, falling back
  /// to this. Dropping it in the same migration that added the cipher would
  /// have thrown away data the customer typed, because SQL cannot encrypt it.
  bloodGroup        String?

  joiningDate        DateTime        @db.Date
  confirmationDate   DateTime?       @db.Date
  exitDate           DateTime?       @db.Date
  departmentId       String?
  designationId      String?
  workLocationId     String?
  shiftId            String?
  weeklyOffPatternId String?
  /// This person's own rest days, when they differ from every named pattern:
  /// `{ type: "FIXED", days: [2] }` or `{ type: "MULTIPLE", days: [2, 5] }`.
  /// Consulted before the named pattern and the organisation default. Null
  /// means "as the pattern says". Set from the Week off card on the profile.
  weeklyOffConfig    Json?
  /// This person's own paid week-off quota a month. Null falls through to the
  /// designation, then to the payroll rule -- the same three layers leave
  /// allocation already has.
  weekOffsPerMonth   Int?
  employmentType     EmploymentType  @default(FULL_TIME)
  workMode           WorkMode        @default(ONSITE)
  employmentState    EmploymentState @default(REGULAR)
  active             Boolean         @default(true)

  /// Overrides the organisation's `marking.self` attendance rule for this one
  /// person. Null means "follow the organisation", which is what every row says
  /// until somebody decides otherwise. It exists so that an organisation moving
  /// to office-device-only does not lock out the field staff whose job is to be
  /// somewhere else. Resolved by `mayMarkFromOwnDevice` in
  /// src/domain/attendance/policy.ts.
  allowSelfMarking Boolean?

  panCipher         String?
  aadhaarCipher     String?
  bankNameCipher    String?
  bankAccountCipher String?
  bankIfscCipher    String?
  uanCipher         String?
  pfNumberCipher    String?

  /// Reference photo used to verify attendance selfies.
  facePhotoKey         String?
  /// The 128-d descriptor derived from it, encrypted at rest. Biometric data:
  /// it is never returned to a client and is deleted with the enrolment.
  faceDescriptorCipher String?
  faceEnrolledAt       DateTime?
  faceEnrolledById     String?
  /// When the employee agreed to face verification.
  faceConsentAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation      Designation?      @relation(fields: [designationId], references: [id], onDelete: SetNull)
  workLocation     WorkLocation?     @relation(fields: [workLocationId], references: [id], onDelete: SetNull)
  shift            Shift?            @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  weeklyOffPattern WeeklyOffPattern? @relation(fields: [weeklyOffPatternId], references: [id], onDelete: SetNull)

  managers          ReportingRelationship[] @relation("Subordinate")
  reports           ReportingRelationship[] @relation("Manager")
  chatThreadsA      ChatThread[]            @relation("ChatThreadA")
  chatThreadsB      ChatThread[]            @relation("ChatThreadB")
  chatMessages      ChatMessage[]           @relation("ChatMessageSender")
  chatBlocksMade    ChatBlock[]             @relation("ChatBlocker")
  chatBlocksAgainst ChatBlock[]             @relation("ChatBlocked")
  chatReports       ChatReport[]            @relation("ChatReporter")
  stateHistory      EmploymentStateChange[]
  trainingPlans     TrainingPlan[]
  salaryProfiles    SalaryProfile[]
  attendanceDays    AttendanceDay[]
  attendanceEvents  AttendanceEvent[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  payrollItems      PayrollItem[]
  advances          SalaryAdvance[]
  documents         EmployeeDocument[]
  letters           Letter[]

  exitRecord          ExitRecord?
  fnfSettlements      FnfSettlement[]
  reimbursementClaims ReimbursementClaim[]
  onboardingTasks     OnboardingTask[]
  assetAssignments    AssetAssignment[]
  goals               Goal[]
  performanceReviews  PerformanceReview[]        @relation("ReviewSubject")
  reviewsGiven        PerformanceReview[]        @relation("ReviewReviewer")
  regularisations     AttendanceRegularisation[]
  attendancePins      AttendancePin[]
  pinAuthority        AttendancePinAuthority[]   @relation("PinAuthority")
  payrollAdjustments  PayrollAdjustment[]
  recognitionScores   RecognitionScore[]
  recognitionAwards   RecognitionAward[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, active])
  @@index([organizationId, departmentId])
  @@index([organizationId, employmentState])
}

/// Employee-to-employee messaging.
///
/// One thread per pair, forever. The pair is stored in a canonical order --
/// `employeeAId < employeeBId` -- so a conversation cannot be opened twice from
/// the two ends and produce two unread counts nobody can reconcile.
///
/// The thread outlives the messages: they are purged after thirty days; the
/// pair's identity and each side's read position are not.
model ChatThread {
  id             String    @id @default(cuid())
  organizationId String
  employeeAId    String
  employeeBId    String
  lastMessageAt  DateTime?
  /// When each side last opened it. Marking a conversation read is then one
  /// UPDATE rather than one per message.
  aLastReadAt    DateTime?
  bLastReadAt    DateTime?
  createdAt      DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeA    Employee      @relation("ChatThreadA", fields: [employeeAId], references: [id], onDelete: Cascade)
  employeeB    Employee      @relation("ChatThreadB", fields: [employeeBId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@unique([organizationId, employeeAId, employeeBId])
  @@index([organizationId, employeeAId, lastMessageAt])
  @@index([organizationId, employeeBId, lastMessageAt])
}

/// A message.
///
/// There is no `deletedAt`, no `editedAt` and no delete path anywhere in the
/// product -- not for the sender, not for an administrator. The only removal is
/// the thirty-day age-out in `runMaintenanceJobs`. A column here would be the
/// first step towards somebody adding one.
model ChatMessage {
  id             String   @id @default(cuid())
  organizationId String
  threadId       String
  senderId       String
  body           String   @db.VarChar(2000)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread       ChatThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender       Employee     @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([organizationId, senderId, createdAt])
}

/// Somebody has blocked somebody.
///
/// Silent to the person blocked: they can still send, and it simply does not
/// arrive. Telling them is what makes blocking dangerous for the person who
/// needed it.
model ChatBlock {
  id             String   @id @default(cuid())
  organizationId String
  blockerId      String
  blockedId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blocker      Employee     @relation("ChatBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked      Employee     @relation("ChatBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([organizationId, blockerId])
}

/// A conversation somebody has reported to their administrators.
///
/// The reason and the reporter are kept; the messages are not copied, because
/// they are already in the thread and duplicating them would leave a second,
/// unpurged copy of a private conversation somewhere else.
model ChatReport {
  id             String    @id @default(cuid())
  organizationId String
  threadId       String
  reporterId     String
  reason         String    @db.VarChar(1000)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reporter     Employee     @relation("ChatReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([organizationId, reviewedAt])
}

model ReportingRelationship {
  id             String        @id @default(cuid())
  organizationId String
  employeeId     String
  managerId      String
  type           ReportingType @default(PRIMARY)
  startDate      DateTime?     @db.Date
  endDate        DateTime?     @db.Date
  createdAt      DateTime      @default(now())

  employee Employee @relation("Subordinate", fields: [employeeId], references: [id], onDelete: Cascade)
  manager  Employee @relation("Manager", fields: [managerId], references: [id], onDelete: Cascade)

  /// No `@@unique([employeeId, managerId, type])`: re-appointing a previous
  /// manager has to write a *new* row, or the old span is overwritten and the
  /// approval they gave last March loses its manager. What must stay unique is
  /// one *live* PRIMARY line per employee, which Prisma cannot express -- it is
  /// a partial index created by hand in the migration and named
  /// `ReportingRelationship_one_live_primary`. `prisma db pull` will not see
  /// it, so a future `migrate dev` will not recreate it.
  @@index([organizationId, managerId, endDate])
  @@index([organizationId, employeeId, endDate])
}

model EmploymentStateChange {
  id          String           @id @default(cuid())
  employeeId  String
  fromState   EmploymentState?
  toState     EmploymentState
  effectiveOn DateTime         @db.Date
  reason      String?
  actorId     String?
  automatic   Boolean          @default(false)
  createdAt   DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveOn])
}

model TrainingPlan {
  id                   String          @id @default(cuid())
  organizationId       String
  employeeId           String
  startDate            DateTime        @db.Date
  endDate              DateTime        @db.Date
  mode                 String // PERCENT | FIXED | UNPAID
  percent              Decimal?        @db.Decimal(6, 3)
  fixedAmountPaise     Int?
  postTrainingState    EmploymentState @default(REGULAR)
  postTrainingCtcPaise Int?
  completedAt          DateTime?
  note                 String?
  createdAt            DateTime        @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, endDate])
  @@index([employeeId])
}

// ============================================================ ATTENDANCE

model AttendanceDay {
  id                String           @id @default(cuid())
  organizationId    String
  employeeId        String
  date              DateTime         @db.Date
  status            AttendanceStatus @default(NOT_MARKED)
  systemStatus      AttendanceStatus @default(NOT_MARKED)
  shiftId           String?
  firstCheckInAt    DateTime?
  lastCheckOutAt    DateTime?
  workedMinutes     Int              @default(0)
  breakMinutes      Int              @default(0)
  lateMinutes       Int              @default(0)
  earlyLeaveMinutes Int              @default(0)
  overtimeMinutes   Int              @default(0)
  isExtraDay        Boolean          @default(false)
  leaveRequestId    String?
  holidayId         String?
  remarks           String?
  overriddenById    String?
  overriddenAt      DateTime?
  overrideReason    String?
  source            AttendanceSource @default(SELF_GPS)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  events       AttendanceEvent[]

  @@unique([employeeId, date])
  @@index([organizationId, date])
  @@index([organizationId, status, date])
}

model AttendanceEvent {
  id               String              @id @default(cuid())
  organizationId   String
  employeeId       String
  attendanceDayId  String?
  type             AttendanceEventType
  occurredAt       DateTime
  latitude         Decimal?            @db.Decimal(10, 7)
  longitude        Decimal?            @db.Decimal(10, 7)
  accuracyMeters   Int?
  distanceMeters   Int?
  withinGeofence   Boolean             @default(false)
  workLocationId   String?
  selfieKey        String?
  /// Set when the retention job deletes the image; the row itself is kept.
  selfiePurgedAt   DateTime?
  /// Face-verification outcome. Score is cosine similarity against the enrolled
  /// reference; null when matching was off or could not run.
  faceMatchScore   Decimal?            @db.Decimal(6, 5)
  faceMatchPassed  Boolean?
  faceMatchReason  String?
  /// Raised when the match failed, was skipped, or the photo was unusable.
  flaggedForReview Boolean             @default(false)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  deviceInfo       Json?
  ipAddress        String?
  source           AttendanceSource    @default(SELF_GPS)
  /// Set only on a kiosk mark that skipped the face check. A typed column
  /// rather than a note, because "how many marks bypassed verification last
  /// month" is a question an auditor will ask and a free-text field cannot
  /// answer.
  kioskBypass      KioskBypass?
  /// Who authorised the bypass — the manager who issued the PIN, or the
  /// supervisor who stood at the device.
  bypassById       String?
  note             String?
  createdAt        DateTime            @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceDay AttendanceDay? @relation(fields: [attendanceDayId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([employeeId, occurredAt])
  @@index([organizationId, flaggedForReview])
}

// ============================================================ LEAVE

model LeaveType {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  code             String
  paid             Boolean  @default(true)
  annualAllocation Decimal  @default(0) @db.Decimal(6, 2)
  accrualMode      String   @default("ANNUAL") // ANNUAL | MONTHLY | NONE
  monthlyAccrual   Decimal  @default(0) @db.Decimal(6, 2)
  carryForward     Boolean  @default(false)
  maxCarryForward  Decimal  @default(0) @db.Decimal(6, 2)
  allowHalfDay     Boolean  @default(true)
  requiresApproval Boolean  @default(true)
  maxConsecutive   Int?
  noticeDays       Int      @default(0)
  countsAsPresent  Boolean  @default(true)
  isCompOff        Boolean  @default(false)
  /// The weekly rest day, taken as a request like any other leave.
  ///
  /// A day booked against this type becomes `WEEK_OFF` on the attendance
  /// record rather than `PAID_LEAVE`, which is what links it to the payroll
  /// rule that counts rest days and pays for the ones nobody got to take. One
  /// marker, so leave, attendance and payroll cannot disagree about what a
  /// rest day is.
  isWeekOff        Boolean  @default(false)
  /// The most days of this type one person may take in a calendar month,
  /// counting pending and approved requests. Null means no monthly cap --
  /// the annual pool is the only limit. Set for the on-demand week off so a
  /// bank of rest days cannot be spent eight in one month.
  maxPerMonth      Int?
  active           Boolean  @default(true)
  color            String   @default("#3b82f6")
  createdAt        DateTime @default(now())

  organization           Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests               LeaveRequest[]
  balances               LeaveBalance[]
  designationAllocations DesignationLeaveAllocation[]

  @@unique([organizationId, code])
}

model LeaveBalance {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  year           Int
  allocated      Decimal  @default(0) @db.Decimal(6, 2)
  accrued        Decimal  @default(0) @db.Decimal(6, 2)
  used           Decimal  @default(0) @db.Decimal(6, 2)
  carriedForward Decimal  @default(0) @db.Decimal(6, 2)
  encashed       Decimal  @default(0) @db.Decimal(6, 2)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([organizationId, year])
}

model LeaveRequest {
  id             String             @id @default(cuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  startDayPart   LeaveDayPart       @default(FULL)
  endDayPart     LeaveDayPart       @default(FULL)
  totalDays      Decimal            @db.Decimal(6, 2)
  reason         String?
  status         LeaveRequestStatus @default(PENDING)
  /// @unreachable-ok announcements have no attachment upload; the body is the whole post
  attachmentKey  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  approvals    LeaveApproval[]

  @@index([organizationId, status])
  @@index([employeeId, startDate])
}

model LeaveApproval {
  id             String         @id @default(cuid())
  leaveRequestId String
  approverId     String
  step           Int            @default(1)
  status         ApprovalStatus @default(PENDING)
  note           String?
  actedAt        DateTime?
  createdAt      DateTime       @default(now())

  request LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, step])
  @@index([approverId, status])
}

