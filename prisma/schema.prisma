// ============================================================ LETTERS & AI

/// An organisation's overrides for one letter category.
///
/// `title` and `bodyTemplate` are **nullable, and that is the point**. A row
/// used to mean "this organisation has its own wording", and both columns were
/// NOT NULL -- so `setFrameworkSignature`, which has to create a row to hang an
/// uploaded signature on, filled them by copying the built-in text verbatim.
/// That froze whatever the defaults said on the day somebody uploaded a
/// signature, and no later improvement to the shipped wording could ever reach
/// them again.
///
/// Null now means "not overridden, use the built-in", so a row can carry a
/// signature, or a signatory name, without also taking ownership of the words.
model LetterTemplate {
  id             String   @id @default(cuid())
  organizationId String
  title          String?
  category       String
  bodyTemplate   String?
  /// Plain text, not HTML. The PDF renderer emits paragraphs and cannot lay out
  /// markup, so the old `headerHtml`/`footerHtml` names described something the
  /// product could never render. They were also read by nothing at all.
  headerText     String?
  footerText     String?
  /// All three fall back to the organisation's when null -- see
  /// `Organization.signatureKey`. A row exists to override, not to repeat.
  signatoryName  String?
  signatoryTitle String?
  signatureKey   String?
  /// Whether the signature and the stamp are placed on this letter.
  ///
  /// Both were unconditional: the signature appeared whenever the template row
  /// had one and the stamp whenever the organisation had one, with nothing
  /// anywhere to say "not on this letter". A salary certificate wants both; an
  /// internal memo often wants neither.
  showSignature  Boolean  @default(true)
  showStamp      Boolean  @default(true)
  showLogo       Boolean  @default(true)
  placeholders   String[] @default([])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  letters      Letter[]

  /// One framework per letter type. The product offers a default for every
  /// category and an organisation edits it; two rows for the same category
  /// would make "restore to default" ambiguous about what it restored.
  @@unique([organizationId, category])
  @@unique([organizationId, title])
}

model Letter {
  id             String       @id @default(cuid())
  organizationId String
  employeeId     String
  templateId     String?
  letterNumber   String
  category       String
  subject        String
  body           String
  status         LetterStatus @default(DRAFT)
  issuedOn       DateTime?    @db.Date
  fileKey        String?
  aiGenerated    Boolean      @default(false)
  aiPrompt       String?
  aiModel        String?
  variables      Json         @default("{}")
  createdById    String?
  issuedById     String?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template     LetterTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([organizationId, letterNumber])
  @@index([organizationId, employeeId])
}

model AiConfig {
  id                  String    @id @default(cuid())
  organizationId      String    @unique
  provider            String    @default("openrouter")
  apiKeyCipher        String?
  model               String    @default("z-ai/glm-5.3-flash")
  letterSystemPrompt  String?
  payrollSystemPrompt String?
  temperature         Decimal   @default(0.3) @db.Decimal(3, 2)
  maxTokens           Int       @default(2048)
  monthlyTokenCap     Int?
  tokensUsedThisMonth Int       @default(0)
  usageResetAt        DateTime?
  enabled             Boolean   @default(true)
  /// Whether this organisation's own administrator may set the API key.
  ///
  /// Off means Broadmate holds it: the organisation sends the key over and the
  /// Superadmin pastes it in on their behalf. The key is encrypted either way —
  /// this only decides who is allowed to put it there.
  orgMayManageKey     Boolean   @default(true)
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ============================================================ CROSS-CUTTING

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  actorEmail     String?
  actorRole      String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model Notification {
  id             String             @id @default(cuid())
  organizationId String?
  userId         String
  type           String
  title          String
  body           String?
  link           String?
  status         NotificationStatus @default(UNREAD)
  metadata       Json?
  createdAt      DateTime           @default(now())
  readAt         DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

/// Uploaded files, stored in the database rather than on disk.
///
/// Everything here is compressed on the way in (see `lib/storage/compress.ts`),
/// so a selfie is roughly 60–120 KB rather than the 3–6 MB a phone produces.
/// Keeping them in Postgres means one backup covers the data *and* its files,
/// and nothing is lost when the app runs on a host with an ephemeral filesystem.
model FileObject {
  id             String   @id @default(cuid())
  /// Opaque, tenant-prefixed path: `org/<orgId>/<kind>/<random>.<ext>`
  key            String   @unique
  organizationId String?
  kind           String
  mimeType       String
  sizeBytes      Int
  checksum       String
  /// Null when the bytes live elsewhere — the Supabase Storage driver keeps the
  /// row as an index (retention, orphan sweeps and storage reporting all read
  /// this table directly) and puts the bytes in a bucket.
  data           Bytes?
  createdAt      DateTime @default(now())

  @@index([organizationId, kind])
  @@index([createdAt])
}

model RateLimitCounter {
  id        String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// ============================================================ FEATURE FLAGS & SEATS

/// Level 1: what the Superadmin allows this organisation to use at all.
model FeatureGrant {
  id             String   @id @default(cuid())
  organizationId String
  featureKey     String
  granted        Boolean  @default(true)
  note           String?
  grantedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureKey])
  @@index([organizationId])
}

/// Level 2: what the organisation's own Admin has switched on, within the grant.
/// A module switched on or off for everybody holding one designation.
///
/// The organisation-wide setting says what the company does; this says what a
/// job does. "Nobody on the shop floor needs the reimbursements screen" is a
/// statement about a role, and making it one row rather than forty is the
/// difference between a policy somebody maintains and one they abandon.
///
/// Absent means "follow the organisation". There is no third state, because a
/// row that says "same as the organisation" is a row somebody has to keep in
/// step by hand.
/// How many days of one leave type a designation gets.
///
/// `LeaveType.annualAllocation` is one number for the whole company, which is
/// not how leave works anywhere: a manager and a trainee do not get the same
/// casual leave. This is the per-designation answer, and the type's own number
/// is what a designation without a row here falls back to.
///
/// Still above `LeaveBalance.allocated`, which stays the finest layer -- the
/// one person whose contract says something different.
model DesignationLeaveAllocation {
  id               String   @id @default(cuid())
  organizationId   String
  designationId    String
  leaveTypeId      String
  /// Days a year. Same units and precision as `LeaveType.annualAllocation`.
  annualAllocation Decimal  @default(0) @db.Decimal(5, 2)
  updatedById      String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  designation  Designation  @relation(fields: [designationId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([designationId, leaveTypeId])
  @@index([organizationId])
  @@index([leaveTypeId])
}

model DesignationModuleSetting {
  id             String   @id @default(cuid())
  organizationId String
  designationId  String
  moduleKey      String
  enabled        Boolean
  updatedById    String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  designation  Designation  @relation(fields: [designationId], references: [id], onDelete: Cascade)

  @@unique([designationId, moduleKey])
  @@index([organizationId])
}

/// A module switched on or off for one person, whatever their designation says.
///
/// The exception the designation does not describe, and the reason both layers
/// exist: an organisation will always have somebody who is the one person in
/// their role who needs a thing, or the one who must not have it.
model UserModuleSetting {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  moduleKey      String
  enabled        Boolean
  updatedById    String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("ModuleSetting", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleKey])
  @@index([organizationId])
}

model OrgModuleSetting {
  id             String   @id @default(cuid())
  organizationId String
  moduleKey      String
  enabled        Boolean  @default(false)
  config         Json     @default("{}")
  updatedById    String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleKey])
  @@index([organizationId])
}

/// Daily count of billable (ACTIVE) employees — powers seat history and overage checks.
model SeatUsageSnapshot {
  id              String   @id @default(cuid())
  organizationId  String
  date            DateTime @db.Date
  activeEmployees Int
  seats           Int
  overage         Int      @default(0)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId, date])
}

// ============================================================ EXIT & FULL-AND-FINAL

model ExitRecord {
  id                  String     @id @default(cuid())
  organizationId      String
  employeeId          String     @unique
  type                ExitType   @default(RESIGNATION)
  status              ExitStatus @default(INITIATED)
  resignationDate     DateTime   @db.Date
  lastWorkingDay      DateTime   @db.Date
  noticeDaysRequired  Int        @default(0)
  noticeDaysServed    Int        @default(0)
  /// Shortfall days recovered from the final settlement.
  noticeShortfallDays Int        @default(0)
  reason              String?
  exitInterviewNote   String?
  /// @unreachable-ok never asked at exit and never shown; rehire is a conversation, not a flag
  rehireEligible      Boolean    @default(true)
  createdById         String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checklist    ExitChecklistItem[]
  settlement   FnfSettlement?

  @@index([organizationId, status])
  @@index([organizationId, lastWorkingDay])
}

model ExitChecklistItem {
  id            String     @id @default(cuid())
  exitRecordId  String
  title         String
  description   String?
  ownerUserId   String?
  status        TaskStatus @default(PENDING)
  dueOn         DateTime?  @db.Date
  completedAt   DateTime?
  completedById String?
  note          String?
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())

  exitRecord ExitRecord @relation(fields: [exitRecordId], references: [id], onDelete: Cascade)

  @@index([exitRecordId, status])
}

model FnfSettlement {
  id              String    @id @default(cuid())
  organizationId  String
  employeeId      String
  exitRecordId    String?   @unique
  status          FnfStatus @default(DRAFT)
  /// Frozen inputs + policy so a settled F&F never moves when settings change.
  snapshot        Json?
  earningsPaise   Int       @default(0)
  deductionsPaise Int       @default(0)
  netPaise        Int       @default(0)
  paidPaise       Int       @default(0)
  computedAt      DateTime?
  approvedById    String?
  approvedAt      DateTime?
  settledOn       DateTime? @db.Date
  fileKey         String?
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  exitRecord   ExitRecord?  @relation(fields: [exitRecordId], references: [id], onDelete: SetNull)
  lines        FnfLine[]

  @@index([organizationId, status])
  @@index([employeeId])
}

model FnfLine {
  id           String        @id @default(cuid())
  settlementId String
  code         String
  label        String
  kind         ComponentKind
  amountPaise  Int
  formula      String?
  sortOrder    Int           @default(0)

  settlement FnfSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
}

// ============================================================ REIMBURSEMENTS

model ReimbursementClaim {
  id             String      @id @default(cuid())
  organizationId String
  employeeId     String
  claimNumber    String
  title          String
  status         ClaimStatus @default(DRAFT)
  totalPaise     Int         @default(0)
  approvedPaise  Int         @default(0)
  /// Payroll period the approved amount is paid in.
  periodYear     Int?
  periodMonth    Int?
  /// The run that paid it, stamped when that run is locked. Deliberately the
  /// run and not the payroll *item*: recalculating a run deletes and rebuilds
  /// its items, so a marker hanging off an item is erased by the next
  /// calculation — the same defect that had to be fixed for PayrollAdjustment.
  paidInRunId    String?
  paidAt         DateTime?
  submittedAt    DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  paidInRun    PayrollRun?         @relation(fields: [paidInRunId], references: [id], onDelete: SetNull)
  items        ReimbursementItem[]

  @@unique([organizationId, claimNumber])
  @@index([organizationId, status])
  @@index([employeeId])
}

model ReimbursementItem {
  id          String   @id @default(cuid())
  claimId     String
  category    String
  description String?
  spentOn     DateTime @db.Date
  amountPaise Int
  fileKey     String?
  fileName    String?
  createdAt   DateTime @default(now())

  claim ReimbursementClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

// ============================================================ ONBOARDING & ASSETS

model OnboardingTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        OnboardingTemplateTask[]
  issued       OnboardingTask[]

  @@unique([organizationId, name])
}

model OnboardingTemplateTask {
  id            String      @id @default(cuid())
  templateId    String
  title         String
  description   String?
  /// Which role is expected to complete it; the actual owner is set on issue.
  ownerRole     SystemRole?
  dueOffsetDays Int         @default(0)
  sortOrder     Int         @default(0)

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model OnboardingTask {
  id             String     @id @default(cuid())
  organizationId String
  employeeId     String
  templateId     String?
  title          String
  description    String?
  ownerUserId    String?
  dueOn          DateTime?  @db.Date
  status         TaskStatus @default(PENDING)
  completedAt    DateTime?
  completedById  String?
  note           String?
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template     OnboardingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([employeeId])
}

model Asset {
  id             String      @id @default(cuid())
  organizationId String
  assetTag       String
  name           String
  category       String
  serialNumber   String?
  /// @unreachable-ok assets are tracked by who holds them, not by when they were bought
  purchaseDate   DateTime?   @db.Date
  valuePaise     Int?
  status         AssetStatus @default(AVAILABLE)
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  AssetAssignment[]

  @@unique([organizationId, assetTag])
  @@index([organizationId, status])
}

model AssetAssignment {
  id                String    @id @default(cuid())
  organizationId    String
  assetId           String
  employeeId        String
  issuedOn          DateTime  @db.Date
  dueOn             DateTime? @db.Date
  returnedOn        DateTime? @db.Date
  conditionOnIssue  String?
  conditionOnReturn String?
  acknowledgedAt    DateTime?
  /// Charged back through the final settlement when an asset is not returned.
  recoveryPaise     Int?
  note              String?
  createdById       String?
  createdAt         DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId])
  @@index([assetId])
}

// ============================================================ PERFORMANCE

model ReviewCycle {
  id               String            @id @default(cuid())
  organizationId   String
  name             String
  startDate        DateTime          @db.Date
  endDate          DateTime          @db.Date
  /// @unreachable-ok a cycle has one window; neither due date is set or shown
  selfReviewDue    DateTime?         @db.Date
  /// @unreachable-ok as above -- declared with the model and never wired to anything
  managerReviewDue DateTime?         @db.Date
  status           ReviewCycleStatus @default(DRAFT)
  /// Competency list evaluated in this cycle: [{ code, label, weight }]
  competencies     Json              @default("[]")
  createdAt        DateTime          @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviews      PerformanceReview[]
  goals        Goal[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model Goal {
  id             String     @id @default(cuid())
  organizationId String
  employeeId     String
  cycleId        String?
  title          String
  description    String?
  weight         Decimal    @default(1) @db.Decimal(5, 2)
  /// The target and progress as free text, from before either was a number.
  ///
  /// Kept rather than migrated. Every goal in production has both null, and the
  /// three that exist say what they are worth in their title -- "Sales 1 lakh".
  /// A text goal keeps working and shows a status; one with a number shows how
  /// far along it is.
  targetValue    String?
  currentValue   String?
  /// What the numbers below are measured in, when there are numbers.
  ///
  /// The same vocabulary Employee of the Month already uses, deliberately: a
  /// second unit list would be a second place to add "hours" to.
  unit           RecognitionUnit?
  targetNumber   Decimal?   @db.Decimal(14, 2)
  /// Where the goal has got to. Written only by a `GoalProgress` entry, so the
  /// figure on the goal and the trail behind it cannot disagree.
  currentNumber  Decimal?   @db.Decimal(14, 2)
  status         GoalStatus @default(DRAFT)
  dueOn          DateTime?  @db.Date
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle        ReviewCycle?   @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  progress     GoalProgress[]

  @@index([organizationId, status])
  @@index([employeeId])
}

/// One update to how far along a goal is.
///
/// A log rather than a column, because "kitna hua" is asked repeatedly and the
/// answer people actually want is the shape of it -- was it flat for a month
/// and then jumped, or steady. Overwriting a single number throws that away
/// every time it is asked.
///
/// The assignee writes these and nothing else: the title, the target and the
/// unit stay read-only to them, which is the whole distinction between being
/// given a goal and setting one.
model GoalProgress {
  id             String   @id @default(cuid())
  organizationId String
  goalId         String
  /// The running total, not the increment. "Sales are at 60,000 now" is what
  /// somebody types; how much that was up by is arithmetic anybody can do.
  value          Decimal  @db.Decimal(14, 2)
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goal         Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@index([organizationId])
}

model PerformanceReview {
  id             String       @id @default(cuid())
  organizationId String
  cycleId        String
  employeeId     String
  reviewerId     String
  status         ReviewStatus @default(NOT_STARTED)
  selfComment    String?
  managerComment String?
  selfRating     Decimal?     @db.Decimal(4, 2)
  managerRating  Decimal?     @db.Decimal(4, 2)
  finalRating    Decimal?     @db.Decimal(4, 2)
  submittedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        ReviewCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee     Employee       @relation("ReviewSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer     Employee       @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  ratings      ReviewRating[]

  @@unique([cycleId, employeeId])
  @@index([organizationId, status])
  @@index([reviewerId, status])
}

model ReviewRating {
  id           String   @id @default(cuid())
  reviewId     String
  competency   String
  selfScore    Decimal? @db.Decimal(4, 2)
  managerScore Decimal? @db.Decimal(4, 2)
  comment      String?

  review PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, competency])
}

// ============================================================ ATTENDANCE REGULARISATION

/// Employee-side remedy for a missed or wrong punch. Admin override still exists,
/// but an employee should not need an admin to fix their own forgotten check-out.
model AttendanceRegularisation {
  id                String               @id @default(cuid())
  organizationId    String
  employeeId        String
  date              DateTime             @db.Date
  requestedStatus   AttendanceStatus
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason            String
  status            RegularisationStatus @default(PENDING)
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([organizationId, status])
}

// ============================================================ SECURITY & PUSH

model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  /// @unreachable-ok web push was never built; nothing subscribes and nothing sends
  p256dh     String
  auth       String
  userAgent  String?
  /// @unreachable-ok part of the unbuilt web push model
  lastUsedAt DateTime?
  /// @unreachable-ok part of the unbuilt web push model
  failCount  Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginEvent {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  email          String
  success        Boolean
  /// BAD_PASSWORD | LOCKED | SUSPENDED | NO_SUCH_USER | BAD_TOTP | OK
  reason         String?
  ipAddress      String?
  userAgent      String?
  deviceLabel    String?
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

model DataExportJob {
  id             String       @id @default(cuid())
  organizationId String?
  requestedById  String
  /// PLATFORM | ORGANIZATION | EMPLOYEE
  scope          String
  targetId       String?
  status         ExportStatus @default(QUEUED)
  fileKey        String?
  sizeBytes      Int?
  /// Shown once so the requester can open the encrypted archive.
  passwordCipher String?
  error          String?
  expiresAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([requestedById, createdAt])
}

/// A thing an organisation measures people on for Employee of the Month.
///
/// Kept deliberately small — five at most, three suggested. Past a handful,
/// nobody can explain to somebody why they did not win, and a recognition
/// scheme that cannot be explained stops being recognition.
model RecognitionParameter {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  /// What the number means. RUPEES is entered in rupees and shown as money.
  unit           RecognitionUnit      @default(COUNT)
  /// Whether more is better. Shrinkage, escalations and absence are all the
  /// other way round, and a scheme that cannot say so is useless to half the
  /// organisations that would use it.
  direction      RecognitionDirection @default(HIGHER_IS_BETTER)
  /// Share of the final score, 0-100. The active parameters must total 100.
  weight         Int                  @default(0)
  /// MANUAL is typed in monthly; the rest are computed from data already held.
  source         RecognitionSource    @default(MANUAL)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scores       RecognitionScore[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

/// One month's run of the award.
model RecognitionCycle {
  id             String            @id @default(cuid())
  organizationId String
  periodYear     Int
  periodMonth    Int
  status         RecognitionStatus @default(DRAFT)
  publishedAt    DateTime?
  publishedById  String?
  /// What the announcement said, written by a person or drafted by AI.
  citation       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scores       RecognitionScore[]
  awards       RecognitionAward[]

  @@unique([organizationId, periodYear, periodMonth])
  @@index([organizationId, status])
}

/// One employee's figure on one parameter for one month, raw and normalised.
///
/// Both are stored because the raw value is what somebody disputes and the
/// normalised one is what produced the ranking. Recomputing the second from the
/// first later would give a different answer once the cohort has changed.
model RecognitionScore {
  id          String  @id @default(cuid())
  cycleId     String
  employeeId  String
  parameterId String
  /// Deliberately not integer paise, unlike every other number in this product:
  /// the same column also holds percentages, counts and hours, and this is a
  /// metric that is never paid out.
  rawValue    Decimal @db.Decimal(18, 4)
  /// 0-1 within the cohort for this month, direction already applied.
  normalised  Decimal @db.Decimal(6, 5)

  cycle     RecognitionCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee  Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  parameter RecognitionParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@unique([cycleId, employeeId, parameterId])
  @@index([cycleId, employeeId])
}

/// The result, once it has been published.
model RecognitionAward {
  id             String   @id @default(cuid())
  organizationId String
  cycleId        String
  employeeId     String
  rank           Int
  totalScore     Decimal  @db.Decimal(6, 2)
  /// Set when an administrator chose somebody other than the top score, with
  /// the reason. Shown on the award, because an unexplained override is worse
  /// than no override.
  overriddenById String?
  overrideReason String?
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        RecognitionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([cycleId, rank])
  @@index([organizationId, employeeId])
}

enum RecognitionUnit {
  RUPEES
  COUNT
  PERCENT
  HOURS
  POINTS
}

enum RecognitionDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum RecognitionSource {
  MANUAL
  PRESENT_DAYS
  PUNCTUALITY
  OVERTIME_HOURS
  GOALS_COMPLETED
}

enum RecognitionStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}
