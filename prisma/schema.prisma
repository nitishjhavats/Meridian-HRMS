/// Why a kiosk mark was accepted without a face match. Both are recorded and
/// both raise the review flag; neither is a normal way to mark a day.
enum KioskBypass {
  /// A single-use PIN issued by an admin or the employee's reporting manager.
  PIN
  /// A supervisor stood at the device and entered their own credentials.
  SUPERVISOR
}

/// Who a reception device lists.
///
/// The roster was the whole organisation and nothing else, because a device
/// marks attendance for whoever walks up to it. That is right for one office
/// and wrong for a company with four branches, where a receptionist scrolls
/// past two hundred names to find the twelve who work in that building.
///
/// Asked when the device is created, changeable afterwards. Existing devices
/// keep `ORGANISATION`, which is what they do today -- a column default that
/// narrowed on deploy would make people vanish from screens overnight with no
/// explanation on the screen they vanished from.
enum KioskRosterScope {
  ORGANISATION
  WORK_LOCATION
}

model KioskDevice {
  id             String    @id @default(cuid())
  organizationId String
  /// The KIOSK-role login this device signs in as.
  userId         String    @unique
  /// Where the device stands. It *is* the geofence: a reception desktop has no
  /// GPS, so this location supplies the coordinates on every mark it makes.
  workLocationId String
  label          String
  /// Whether this screen lists the whole organisation or only its own branch.
  /// Employees with no work location at all appear on an ORGANISATION device
  /// and on no WORK_LOCATION one, which the create form warns about by name.
  rosterScope    KioskRosterScope @default(ORGANISATION)
  createdAt      DateTime  @default(now())
  createdById    String?
  revokedAt      DateTime?
  lastSeenAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workLocation WorkLocation @relation(fields: [workLocationId], references: [id], onDelete: Restrict)

  @@index([organizationId, revokedAt])
}

/// A one-shot code that lets somebody mark attendance at a kiosk when the face
/// check will not pass — a new beard, a bandage, no enrolment yet.
///
/// Short-lived and single-use by design, so a six-digit secret is safe: it
/// expires in minutes, it is spent on first use, and attempts are rate limited.
/// Nothing long-lived is ever written down or left on the device.
model AttendancePin {
  id             String    @id @default(cuid())
  organizationId String
  employeeId     String
  /// SHA-256. The plaintext is shown once, to whoever issued it.
  codeHash       String
  issuedById     String
  /// @unreachable-ok never read; `createdAt` is what the expiry is measured from
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  reason         String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId, expiresAt])
  @@index([codeHash])
}

/**
 * Who an administrator has said may issue an attendance PIN.
 * A PIN is the way past a face check that will not pass -- a scar, a new beard,
 * a camera that cannot see in the dark -- so the question "who may hand one
 * out?" is a real access decision and used to have no answer at all: the code
 * fell back to `attendance.override` or being somebody's reporting manager,
 * neither of which an administrator could see, let alone change.
 * Two levels, mirroring how permissions already work here: name a designation
 * and everybody holding it may issue, or name one person. A row of either kind
 * grants; there is no deny row, because an administrator removing somebody's
 * authority should remove the row rather than add a second one contradicting
 * the first.
 */
model AttendancePinAuthority {
  id             String   @id @default(cuid())
  organizationId String
  /// Exactly one of these three is set.
  designationId  String?
  employeeId     String?
  /// A whole login role -- "every HR manager", "every team lead". Owner and
  /// Admin are never rows: they hold `attendance.pin.issue` from the role bundle.
  role           SystemRole?
  createdAt      DateTime @default(now())
  createdById    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  designation  Designation? @relation(fields: [designationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation("PinAuthority", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, designationId])
  @@unique([organizationId, employeeId])
  @@unique([organizationId, role])
  @@index([organizationId])
}

