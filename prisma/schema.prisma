  approvedAt     DateTime?
  approvedById   String?
  lockedAt       DateTime?
  lockedById     String?
  note           String?
  createdAt      DateTime         @default(now())
  createdById    String?

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          PayrollItem[]
  adjustments    PayrollAdjustment[]
  /// Claims this run paid, stamped at lock. See ReimbursementClaim.paidInRunId.
  reimbursements ReimbursementClaim[]

  @@unique([organizationId, periodYear, periodMonth, revision])
  @@index([organizationId, periodYear, periodMonth])
  @@index([organizationId, status])
}

model PayrollItem {
  id                    String                  @id @default(cuid())
  organizationId        String
  payrollRunId          String
  employeeId            String
  ctcMonthlyPaise       Int
  basisDays             Decimal                 @db.Decimal(6, 2)
  payableDays           Decimal                 @db.Decimal(6, 2)
  presentDays           Decimal                 @db.Decimal(6, 2)
  paidLeaveDays         Decimal                 @db.Decimal(6, 2)
  unpaidLeaveDays       Decimal                 @db.Decimal(6, 2)
  halfDays              Decimal                 @db.Decimal(6, 2)
  absentDays            Decimal                 @db.Decimal(6, 2)
  weekOffDays           Decimal                 @db.Decimal(6, 2)
  holidayDays           Decimal                 @db.Decimal(6, 2)
  extraDays             Decimal                 @db.Decimal(6, 2)
  lateCount             Int                     @default(0)
  overtimeMinutes       Int                     @default(0)
  grossPaise            Int
  earningsPaise         Int
  deductionsPaise       Int
  advanceRecoveredPaise Int                     @default(0)
  netPaise              Int
  paidPaise             Int                     @default(0)
  settlement            PaymentSettlementStatus @default(UNPAID)
  earnings              Json
  deductions            Json
  trace                 Json
  warnings              String[]                @default([])
  /// Compensatory-off days this item earned, as the engine computed them.
  /// Held here rather than recomputed, so the leave credit and the payslip
  /// can never disagree about what was earned.
  compOffCredits        Json?
  /// What the engine decided to recover against each advance this month, kept so
  /// the write-back at lock uses exactly that rather than re-deriving it from a
  /// policy that may have changed in between. Same shape and same reasoning as
  /// `compOffCredits` above.
  advanceRecoveries     Json?
  /// Stamped when those recoveries were written back, so unlocking and locking
  /// again cannot recover the same money twice.
  advancesAppliedAt     DateTime?
  /// When those days were added to the leave balance. Set once, at lock, and
  /// checked before crediting so unlocking and re-locking cannot pay twice.
  compOffCreditedAt     DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  run      PayrollRun      @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payments SalaryPayment[]
  slip     SalarySlip?

  @@unique([payrollRunId, employeeId])
  @@index([organizationId, settlement])
  @@index([employeeId])
}

/// A change an administrator makes to one person's pay for one month.
///
/// Attached to the run and the employee rather than to a `PayrollItem`, because
/// recalculating a run deletes and rebuilds its items — and an adjustment that
/// cascaded away with them would apply once and then vanish, which is worse than
/// not applying at all. It is a decision about somebody's pay for a month, not
/// about a particular calculation of it.
model PayrollAdjustment {
  id             String        @id @default(cuid())
  organizationId String
  payrollRunId   String
  employeeId     String
  code           String
  label          String
  kind           ComponentKind
  amountPaise    Int
  reason         String?
  createdById    String?
  createdAt      DateTime      @default(now())

  run      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([payrollRunId, employeeId])
  @@index([organizationId])
}

