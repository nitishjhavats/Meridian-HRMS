// HRMS + Payroll — multi-tenant schema
// Money is stored as INTEGER MINOR UNITS (paise). Percentages are Decimal.

generator client {
  provider      = "prisma-client-js"
  // The image builds and runs on node:22-slim (Debian bookworm, OpenSSL 3).
  // Naming it explicitly means a `prisma generate` run on a developer's
  // Windows machine still produces an engine the container can use.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================ ENUMS

enum SystemRole {
  SUPERADMIN
  ORG_OWNER
  ADMIN
  HR_MANAGER
  /// Between HR and a team lead: runs a team, confirms their own people off
  /// probation, corrects their own team's attendance. Declaration order is
  /// seniority here and `findApprover` reads it, so this member has to sit in
  /// the right place -- the migration says `AFTER 'HR_MANAGER'` by hand,
  /// because `ALTER TYPE ... ADD VALUE` appends otherwise.
  MANAGER
  TEAM_LEAD
  /// Authorises an override at an office device, and nothing else.
  ///
  /// Not a seniority tier: a supervisor is a team member who may stand at the
  /// kiosk and vouch for somebody whose face will not scan. That power used to
  /// require MANAGER -- which also confirms people off probation and corrects a
  /// whole team's attendance -- or a hand-granted `attendance.override`, so in
  /// practice offices handed out far more than they meant to.
  ///
  /// Same rule as MANAGER above: declaration order is seniority and
  /// `findApprover` reads it, so the migration places this AFTER 'TEAM_LEAD'
  /// by hand.
  SUPERVISOR
  TEAM_MEMBER
  /// A shared screen left in an office. Not a person: it holds no employee
  /// record, consumes no seat, and can do nothing but mark attendance.
  KIOSK
}

