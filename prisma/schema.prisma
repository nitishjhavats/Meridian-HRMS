  @@index([organizationId, kind, effectiveFrom])
}

model PayrollRun {
  id             String           @id @default(cuid())
  organizationId String
  periodYear     Int
  periodMonth    Int
  periodStart    DateTime         @db.Date
  periodEnd      DateTime         @db.Date
