{
  "name": "meridian-hrms",
  "version": "0.1.0",
  "description": "Open-source multi-tenant HR, attendance and payroll PWA for Indian companies.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/nitishjhavats/meridian-hrms",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-sw.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && vitest run && npm run verify:layout && npm run verify:reachability && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "icons": "node scripts/generate-icons.mjs",
    "secrets": "node scripts/generate-secrets.mjs",
    "face:models": "node scripts/download-face-models.mjs",
    "jobs": "tsx --env-file=.env scripts/run-jobs.ts",
    "verify:sweep": "tsx --env-file=.env scripts/verify-sweep.ts",
    "verify:layout": "tsx scripts/verify-layout.ts",
    "verify:reachability": "tsx scripts/verify-reachability.ts",
    "verify:money": "tsx --env-file=.env scripts/verify-payroll-money.ts",
    "smoke:payment-codes": "tsx --env-file=.env scripts/smoke-payment-codes.ts",
    "smoke:attendance-pin": "tsx --env-file=.env scripts/smoke-attendance-pin.ts",
    "smoke:mark-anyway": "tsx --env-file=.env scripts/smoke-mark-anyway.ts",
    "fonts": "node scripts/download-fonts.mjs",
    "migrate:bloodgroup": "tsx --env-file=.env scripts/migrate-blood-group.mts",
    "mask:aadhaar": "tsx --env-file=.env scripts/mask-aadhaar.mts",
    "backfill:reporting": "tsx --env-file=.env scripts/backfill-reporting.mts",
    "fence:default": "tsx --env-file=.env scripts/set-attendance-fence.mts",
    "attendance:close": "tsx --env-file=.env scripts/close-attendance-days.mts",
    "smoke:day-close": "tsx --env-file=.env scripts/smoke-day-close.ts",
    "holidays:national": "tsx --env-file=.env scripts/seed-national-holidays.mts",
    "unfreeze:letters": "tsx --env-file=.env scripts/unfreeze-letters.mts",
    "modules:enable": "tsx --env-file=.env scripts/enable-modules.mts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-pdf/renderer": "^4.1.6",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.474.0",
    "next": "^15.1.6",
    "onnxruntime-node": "^1.29.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "sharp": "^0.35.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
