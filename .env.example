# ---- Database ----
# Local development: the Postgres in docker-compose.yml.
# Production: point at a dedicated database (or schema). Never at a schema that
# PostgREST exposes — these tables have no row-level security.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hrms?schema=public"

# ---- Auth / crypto ----
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# 32 bytes, base64url. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# This encrypts PAN, Aadhaar, bank details, TOTP secrets and organisation API
# keys. LOSE IT AND THAT DATA IS GONE — there is no recovery path. CHANGE IT AND
# EVERY EXISTING VALUE STOPS DECRYPTING. Escrow it somewhere durable before it
# protects anything real.
PLATFORM_ENCRYPTION_KEY=""

# How long a person stays signed in from their last use. Slides on use; the
# session list under Account -> Security revokes any of them at once. A shared
# office device is fixed at 30 days regardless. (SESSION_MAX_AGE_SECONDS is no
# longer read.)
SESSION_IDLE_DAYS="30"

# ---- App ----
# The origin this is served from. Used for absolute URLs in metadata and as the
# referer sent to OpenRouter.
APP_URL="http://localhost:3000"

# Shared secret for POST /api/jobs/run, called by the scheduler. Generate like
# AUTH_SECRET. Leave empty in development and the endpoint stays disabled.
JOBS_SECRET=""

# ---- Storage ----
# "database" keeps compressed bytes in Postgres (fine locally).
# "supabase"  stores them in a private Supabase Storage bucket (production).
# "local"     writes to STORAGE_LOCAL_DIR.
STORAGE_DRIVER="database"
STORAGE_LOCAL_DIR="./storage"

# Only read when STORAGE_DRIVER=supabase. The service-role key, not the anon key
# — the bucket is private and every read is authorised by the app first.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="hrms-files"

# ---- Face verification ----
# Models are downloaded by `npm run face:models` (the Docker build does it for
# you). Set FACE_MATCHING=off to run without them.
FACE_MODEL_DIR="./models"
FACE_MATCHING="on"

# ---- AI (OpenRouter) ----
# Platform-wide fallback key. An organisation can set its own, which is stored
# encrypted and always wins over this one.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_APP_TITLE="HRMS Payroll PWA"

# ---- Payments ----
# The UPI id customers pay. Platform -> Settings wins once it is saved there;
# this is only read while the settings row has none. Leave empty and the
# platform refuses new orders rather than guess a payee.
PAYMENT_UPI_ID=""

# ---- Seeding (development only) ----
# `npm run db:seed` TRUNCATES every table in the target schema first, so it
# refuses to run unless this is set. Never set it in production.
ALLOW_DESTRUCTIVE_SEED=""
SUPERADMIN_EMAIL="superadmin@hrms.local"
# Required by the seed, which no longer has a default. Use a strong one.
SUPERADMIN_PASSWORD=""

NODE_ENV="development"
